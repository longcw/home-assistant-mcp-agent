# ---- Home Assistant ----
# Base URL only — the agent appends /api/mcp automatically.
HA_URL=https://your-home-assistant.example.com
HA_TOKEN=your-long-lived-access-token

# ---- LiveKit server (self-hosted or Cloud project) ----
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Explicit-dispatch name for this worker (must match the "Agent name" configured in the
# Home Assistant integration — see https://github.com/longcw/ha-livekit-agent-frontend).
AGENT_NAME=ha-agent

# ---- LiveKit Inference gateway (STT / LLM / TTS) ----
# Used for model access. Falls back to LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET
# if these are unset.
LIVEKIT_INFERENCE_URL=https://agent-gateway.livekit.cloud/v1
LIVEKIT_INFERENCE_API_KEY=your-inference-key
LIVEKIT_INFERENCE_API_SECRET=your-inference-secret

# ---- Scheduling ----
# Home timezone, used to resolve relative schedules ("in 1 hour") and stamp scheduled times.
# An IANA name, e.g. Asia/Shanghai, America/New_York. Falls back to TZ, then UTC.
AGENT_TZ=UTC
# A one-time task whose fire time was missed while the scheduler was down still runs once if
# the outage was within this many seconds; older misses are marked "missed" (default 3600).
# MISFIRE_GRACE_SECONDS=3600
# Shared secret guarding the scheduler's HTTP API. Required once the scheduler port is
# published (docker-compose exposes 8080 for the HA management tab). The worker and the
# Home Assistant integration must send the same value. Leave empty for a purely internal
# deployment. Generate one with e.g. `openssl rand -hex 32`.
SCHEDULER_TOKEN=

# ---- Text chat ----
# Bearer token for the text chat endpoints (POST /chat, and the A2A endpoint behind it on
# /home-assistant). Unset leaves them off; voice is unaffected either way.
# Generate one with e.g. `openssl rand -hex 32`.
TEXT_API_TOKEN=
# Seconds a quiet text conversation stays loaded before it is saved and dropped (default 300).
# TEXT_IDLE_TIMEOUT=300
# Seconds without a text turn after which the next one starts a new conversation (8 h).
# TEXT_RENEW_AFTER=28800
# Chat items a loaded text conversation keeps in the agent's context (default 100).
# TEXT_MAX_ITEMS=100
# A phone's notify service (e.g. mobile_app_my_iphone) to show each text turn's progress on,
# replaced in place; unset turns it off. TEXT_LIVE_MODE: notification (default) or activity
# (a Live Activity; see docs/text-endpoint.md for its limits). TEXT_LIVE_CLEAR_AFTER: seconds
# after the last turn before a Live Activity is cleared. TEXT_LIVE_URL: the page a tap opens.
# TEXT_LIVE_ACTIVITY=
# TEXT_LIVE_MODE=notification
# TEXT_LIVE_CLEAR_AFTER=900
# TEXT_LIVE_URL=/dashboard-name/view?lk_tab=text

# ---- Optional model overrides ----
# STT_MODEL=deepgram/nova-3
# STT_LANGUAGE=multi
# LLM_MODEL=google/gemini-2.5-flash
# TTS_MODEL=cartesia/sonic-3
# TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# TTS_LANGUAGE=zh
